# ---- General ----------------------------------------------------------------
ENVIRONMENT=development
# Comma-separated list of allowed frontend origins (no trailing slash)
CORS_ORIGINS=http://localhost:5173,http://localhost:8080
# Set to true when running behind a proxy/load balancer (Render, Railway, nginx)
# so the client IP is read from X-Forwarded-For for rate limiting.
TRUST_PROXY_HEADERS=false
DATABASE_URL=sqlite:///./data/portfolio.db

# ---- "Ask my AI" ------------------------------------------------------------
# anthropic | openai | none   (with no API key the assistant falls back to keyword retrieval)
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Optional model override. Defaults: anthropic -> claude-sonnet-5-5, openai -> gpt-4.1-mini
LLM_MODEL=
# When LLM_PROVIDER=openai, passages are embedded with this model (dense retrieval)
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_TOP_K=4
CHAT_MAX_MESSAGE_CHARS=500
# "Ask my AI": max questions per visitor per window (default: 10 per 24 hours)
CHAT_RATE_LIMIT=10
CHAT_RATE_WINDOW_SECONDS=86400

# ---- Contact form -----------------------------------------------------------
CONTACT_RATE_LIMIT=5
CONTACT_RATE_WINDOW_SECONDS=3600
# Optional: email each new message to you. Leave SMTP_HOST empty to disable.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM=
CONTACT_TO_EMAIL=shafrith777@gmail.com
